.module Chat.Format

.import String.concatenate/2

.export userMessage/1
.export systemMessage/1
.export separator/1

.subroutine userMessage
  .local text
  .local username
  store text
  store username
  load username
  push ": "
  call String.concatenate/2
  load text
  call String.concatenate/2
  return
.end

.subroutine systemMessage
  .local message
  store message
  push "*** "
  load message
  call String.concatenate/2
  push " ***"
  call String.concatenate/2
  return
.end

.subroutine separator
  .local len
  .local result
  .local i
  store len
  push ""
  store result
  push 0
  store i
  loop
    load i
    load len
    gte
    break_if
    load result
    push "="
    call String.concatenate/2
    store result
    load i
    inc
    store i
  end
  load result
  return
.end